[Unit]
Description=CGL+ LabZ SkillExpo Dashboard (Arduino + local Wi-Fi AP)
After=NetworkManager.service avahi-daemon.service
Wants=NetworkManager.service avahi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/cgl-labz
Environment=PYTHONUNBUFFERED=1
Environment=CGL_HOST=0.0.0.0
Environment=CGL_PORT=5000
ExecStart=/usr/bin/python3 /opt/cgl-labz/app.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
