[Unit]
Description=CGL+ LabZ SkillExpo Air Quality Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cgl-labz
Environment=PYTHONUNBUFFERED=1\nExecStart=/usr/bin/python3 /opt/cgl-labz/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
