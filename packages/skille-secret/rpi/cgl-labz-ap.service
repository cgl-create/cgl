[Unit]
Description=CGL+ LabZ Wi-Fi access point startup
Wants=NetworkManager.service
After=NetworkManager.service
Before=cgl-labz.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/rfkill unblock wifi
ExecStart=/bin/sh -c '/usr/bin/nmcli radio wifi on; i=0; while [ "$i" -lt 30 ]; do /usr/bin/nmcli connection up CGL-LabZ-AP && exit 0; i=$((i+1)); sleep 2; done; exit 1'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
