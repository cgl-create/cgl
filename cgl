#!/bin/sh
set -eu
CGL_VERSION="1.0.17"

# Debian packages install CGL under /usr/share/cgl. The bootstrap installer
# uses /usr/local/share/cgl. Prefer the system location when present.
if [ -d /usr/share/cgl ]; then
  CGL_ROOT="/usr/share/cgl"
elif [ -d /usr/local/share/cgl ]; then
  CGL_ROOT="/usr/local/share/cgl"
else
  CGL_ROOT="/usr/local/share/cgl"
fi

CGL_APT_PRIMARY="https://packages.crazygamelabs.co.uk"
CGL_APT_FALLBACK="https://raw.githubusercontent.com/cgl-create/cgl/gh-pages"
CGL_APT_SOURCES="/etc/apt/sources.list.d/cgl.list"

usage() {
  cat <<'EOF'
CGL+ Cmd

Usage:
  cgl version
  cgl help
  cgl run <script>
  cgl update
  cgl update -os rpi
  cgl update -pkg <package>
  cgl update -pkg skille-secret -os rpi -key aqs-skille-key1
  cgl update -os ubuntu
  cgl update -pkg rdp -os -rpi
  cgl update -pkg skille-secret -os rpi -key aqs-skille-key1
  cgl install rdp -os rpi
  cgl install skille-secret -os rpi
  cgl install -revoke rdp -os rpi
  cgl install -rst rdp -os rpi
  cgl install -fix rdp -os rpi
  cgl install rdp -os ubuntu
  cgl run skille-secret -os rpi -key aqs-skille-key1
  cgl autoupdate
  cgl autoupdate on
  cgl autoupdate off
  cgl hello

Supported system package managers:
  apt, dnf, yum, pacman, zypper, apk
EOF
}
die() { printf 'cgl: %s\n' "$*" >&2; exit 1; }

as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    die "root privileges are required (run as root or install sudo)"
  fi
}

detect_pm() {
  if command -v apt-get >/dev/null 2>&1; then printf 'apt\n'
  elif command -v dnf >/dev/null 2>&1; then printf 'dnf\n'
  elif command -v yum >/dev/null 2>&1; then printf 'yum\n'
  elif command -v pacman >/dev/null 2>&1; then printf 'pacman\n'
  elif command -v zypper >/dev/null 2>&1; then printf 'zypper\n'
  elif command -v apk >/dev/null 2>&1; then printf 'apk\n'
  else die "no supported Linux package manager found"; fi
}

apt_repo_available() {
  url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 5 --proto '=https' --tlsv1.2 "$url/dists/stable/Release" >/dev/null 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T 5 -O /dev/null "$url/dists/stable/Release" >/dev/null 2>&1
  else
    return 1
  fi
}

repair_cgl_apt_source() {
  [ "$(id -u)" -eq 0 ] || return 0
  [ -f "$CGL_APT_SOURCES" ] || return 0
  grep -q 'packages.crazygamelabs.co.uk' "$CGL_APT_SOURCES" 2>/dev/null || return 0
  apt_repo_available "$CGL_APT_PRIMARY" && return 0
  printf '%s\n' "CGL+ | Primary package repository is unavailable; switching to GitHub Pages fallback."
  printf '%s\n' "deb [signed-by=/usr/share/keyrings/cgl-archive-keyring.gpg] $CGL_APT_FALLBACK stable main" > "$CGL_APT_SOURCES"
}

pm_update() {
  case "$1" in
    apt)
      repair_cgl_apt_source
      as_root apt-get update
      ;;
    dnf) as_root dnf makecache ;;
    yum) as_root yum makecache ;;
    pacman) as_root pacman -Syu --noconfirm ;;
    zypper) as_root zypper --non-interactive refresh ;;
    apk) as_root apk update ;;
  esac
}

pm_upgrade() {
  case "$1" in
    apt) as_root apt-get upgrade -y ;;
    dnf) as_root dnf upgrade -y ;;
    yum) as_root yum update -y ;;
    pacman) : ;; # pacman -Syu is already performed by pm_update.
    zypper) as_root zypper --non-interactive update ;;
    apk) as_root apk upgrade ;;
  esac
}

pm_install() {
  case "$1" in
    apt) as_root apt-get install -y "$2" ;;
    dnf) as_root dnf install -y "$2" ;;
    yum) as_root yum install -y "$2" ;;
    pacman) as_root pacman -S --noconfirm "$2" ;;
    zypper) as_root zypper --non-interactive install "$2" ;;
    apk) as_root apk add "$2" ;;
  esac
}

pm_remove() {
  case "$1" in
    apt) as_root apt-get remove -y "$2" ;;
    dnf) as_root dnf remove -y "$2" ;;
    yum) as_root yum remove -y "$2" ;;
    pacman) as_root pacman -R --noconfirm "$2" ;;
    zypper) as_root zypper --non-interactive remove "$2" ;;
    apk) as_root apk del "$2" ;;
  esac
}

self_update() {
  pm="$1"
  if [ "$pm" = "apt" ] && command -v dpkg-query >/dev/null 2>&1 &&
     dpkg-query -W -f='${Status}' cgl 2>/dev/null | grep -q 'install ok installed'; then
    printf '%s\n' "CGL+ | Checking for CGL updates..."
    as_root apt-get install --only-upgrade -y cgl
  fi
}

autoupdate_status() {
  if [ -f /etc/cron.daily/cgl-autoupdate ]; then
    printf '%s\n' "CGL+ automatic updates: enabled (daily)"
  else
    printf '%s\n' "CGL+ automatic updates: disabled"
  fi
}

hello() {
  printf '%s\n' "Hello World!"
}

autoupdate_on() {
  if [ "$(id -u)" -eq 0 ]; then
    cat > /etc/cron.daily/cgl-autoupdate <<'EOF'
#!/bin/sh
if command -v cgl >/dev/null 2>&1; then
  cgl update
fi
EOF
    chmod 0755 /etc/cron.daily/cgl-autoupdate
  elif command -v sudo >/dev/null 2>&1; then
    sudo sh -c 'cat > /etc/cron.daily/cgl-autoupdate <<'EOF'
#!/bin/sh
if command -v cgl >/dev/null 2>&1; then
  cgl update
fi
EOF
chmod 0755 /etc/cron.daily/cgl-autoupdate'
  else
    die "sudo is required to enable automatic updates"
  fi
  printf '%s\n' "CGL+ automatic updates enabled (daily)."
}

autoupdate_off() {
  if [ "$(id -u)" -eq 0 ]; then
    rm -f /etc/cron.daily/cgl-autoupdate
  elif command -v sudo >/dev/null 2>&1; then
    sudo rm -f /etc/cron.daily/cgl-autoupdate
  else
    die "sudo is required to disable automatic updates"
  fi
  printf '%s\n' "CGL+ automatic updates disabled."
}

pm_search() {
  case "$1" in
    apt) apt-cache search "$2" ;;
    dnf) dnf search "$2" ;;
    yum) yum search "$2" ;;
    pacman) pacman -Ss "$2" ;;
    zypper) zypper search "$2" ;;
    apk) apk search "$2" ;;
  esac
}

case "${1:-help}" in
version|--version|-v) printf 'cgl %s\n' "$CGL_VERSION" ;;
help|--help|-h) usage ;;
run)
  if [ "$#" -ge 2 ] && [ "$2" = "skille-secret" ]; then
    [ "$3" = "-os" ] && [ "$4" = "rpi" ] && [ "$5" = "-key" ] && [ "$6" = "aqs-skille-key1" ] || die 'usage: cgl run skille-secret -os rpi -key aqs-skille-key1'
    path="$CGL_ROOT/scripts/CGL+-SkillExpo-RPi.sh"
    [ -f "$path" ] || die 'SkillExpo package script is not installed'
    exec "$path" run -key aqs-skille-key1
  fi
  [ "$#" -ge 2 ] || die 'usage: cgl run <script>'
  script="$2"
  case "$script" in */*) path="$script" ;; *) path="$CGL_ROOT/scripts/$script" ;; esac
  [ -f "$path" ] || die "script not found: $script"
  [ -x "$path" ] || chmod +x "$path"
  shift 2
  exec "$path" "$@"
  ;;
update)
  pm="$(detect_pm)"
  if [ "${2:-}" = '-pkg' ] && [ "${3:-}" = 'rdp' ] && [ "${4:-}" = '-os' ] && [ "${5:-}" = '-rpi' ]; then
    path="$CGL_ROOT/scripts/CGL+-RDP-RPi.sh"
    [ -f "$path" ] || die 'Raspberry Pi RDP setup script is not installed'
    exec "$path" install
  fi
  if [ "${2:-}" = '-pkg' ] && [ "${3:-}" = 'skille-secret' ]; then
    path="$CGL_ROOT/scripts/CGL+-SkillExpo-RPi.sh"
    [ -f "$path" ] || die 'SkillExpo package script is not installed'
    if [ "${4:-}" = '-os' ]; then
      [ "${5:-}" = 'rpi' ] || die 'SkillExpo package currently supports: rpi'
      if [ "${6:-}" = '-key' ]; then
        [ "${7:-}" = 'aqs-skille-key1' ] || die 'invalid SkillExpo Project Key'
        exec "$path" update -key "$7"
      fi
      [ "${6:-}" = '' ] || die 'usage: cgl update -pkg skille-secret -os rpi [-key <project-key>]'
    fi
    exec "$path" update
  fi
  if [ "${2:-}" = '-pkg' ] && [ "${3:-}" = 'rdp' ] && [ "${4:-}" = '-os' ] && [ "${5:-}" = '-ubuntu' ]; then
    path="$CGL_ROOT/scripts/CGL+-RDP-Ubuntu.sh"
    [ -f "$path" ] || die 'Ubuntu RDP setup script is not installed'
    exec "$path" install
  fi
  if [ "${2:-}" = '-os' ] && [ "${3:-}" = 'rpi' ]; then
    path="$CGL_ROOT/scripts/CGL+-RPiOS-Update.sh"
    [ -f "$path" ] || die 'RPi update script is not installed'
    exec "$path"
  fi
  if [ "${2:-}" = '-os' ] && [ "${3:-}" = 'ubuntu' ]; then
    path="$CGL_ROOT/scripts/CGL+-Ubuntu-Update.sh"
    [ -f "$path" ] || die 'Ubuntu update script is not installed'
    exec "$path"
  fi
  if [ "${2:-}" = '-pkg' ]; then
    die "unknown CGL+ package: ${3:-}"
  fi
  [ "$#" -eq 1 ] || die 'usage: cgl update | cgl update -os <rpi|ubuntu> | cgl update -pkg <package> [-os <target>] [-key <project-key>]'
  pm_update "$pm"
  pm_upgrade "$pm"
  self_update "$pm"
  ;;
autoupdate)
  case "${2:-status}" in
    status) autoupdate_status ;;
    on|enable) autoupdate_on ;;
    off|disable) autoupdate_off ;;
    *) die 'usage: cgl autoupdate [status|on|off]' ;;
  esac
  ;;
install)
  # RDP install/lifecycle syntax:
  #   cgl install rdp -os rpi
  #   cgl install -revoke rdp -os rpi
  #   cgl install -rst rdp -os rpi
  #   cgl install -fix rdp -os rpi
  if [ "$#" -eq 4 ] && [ "$2" = "skille-secret" ] && [ "$3" = "-os" ] && [ "$4" = "rpi" ]; then
    path="$CGL_ROOT/scripts/CGL+-SkillExpo-RPi.sh"
    [ -f "$path" ] || die 'SkillExpo package script is not installed'
    exec "$path" install
  fi
  if [ "$#" -eq 4 ] && [ "$2" = "rdp" ] && [ "$3" = "-os" ]; then
    case "$4" in
      rpi)
        path="$CGL_ROOT/scripts/CGL+-RDP-RPi.sh"
        [ -f "$path" ] || die 'Raspberry Pi RDP setup script is not installed'
        exec "$path" install
        ;;
      ubuntu)
        path="$CGL_ROOT/scripts/CGL+-RDP-Ubuntu.sh"
        [ -f "$path" ] || die 'Ubuntu RDP setup script is not installed'
        exec "$path" install
        ;;
      *) die 'supported RDP targets: rpi, ubuntu' ;;
    esac
  fi
  if [ "$#" -eq 5 ] && [ "$3" = "rdp" ] && [ "$4" = "-os" ] && { [ "$2" = "-revoke" ] || [ "$2" = "-rst" ] || [ "$2" = "-fix" ]; }; then
    [ "$5" = "rpi" ] || die 'RDP lifecycle actions currently support: rpi'
    path="$CGL_ROOT/scripts/CGL+-RDP-RPi.sh"
    [ -f "$path" ] || die 'Raspberry Pi RDP setup script is not installed'
    exec "$path" "$2"
  fi
  [ "$#" -eq 2 ] || die 'usage: cgl install <package> | cgl install rdp -os <rpi|ubuntu> | cgl install <-revoke|-rst|-fix> rdp -os rpi'
  pm="$(detect_pm)"
  pm_update "$pm"
  pm_install "$pm" "$2"
  ;;
hello)
  hello
  ;;
remove)
  [ "$#" -eq 2 ] || die 'usage: cgl remove <package>'
  pm_remove "$(detect_pm)" "$2"
  ;;
search)
  [ "$#" -eq 2 ] || die 'usage: cgl search <term>'
  pm_search "$(detect_pm)" "$2"
  ;;
list)
  if [ -d "$CGL_ROOT/scripts" ]; then
    for path in "$CGL_ROOT/scripts/"*; do
      [ -f "$path" ] || continue
      basename "$path"
    done
  fi
  ;;
doctor)
  pm="$(detect_pm 2>/dev/null || printf 'none')"
  printf 'CGL+ doctor\nVersion: %s\nRoot: %s\nPackage manager: %s\n' "$CGL_VERSION" "$CGL_ROOT" "$pm"
  ;;
*) die "unknown command '$1'; run 'cgl help'" ;;
esac
